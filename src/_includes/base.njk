<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == "/" %}{{ site.nome }} | Psicologia e psicanálise{% else %}{{ titulo }} | {{ site.nome }}{% endif %}</title>
<meta name="description" content="{{ descricao or site.descricao }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">
{% endif %}<meta property="og:type" content="website">
<meta property="og:locale" content="pt_BR">
<meta property="og:site_name" content="{{ site.nome }}">
<meta property="og:title" content="{{ titulo }}">
<meta property="og:description" content="{{ descricao or site.descricao }}">
<link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/fontes.css">
<link rel="stylesheet" href="/assets/css/{{ css }}.css">
<link rel="stylesheet" href="/assets/css/utilidades.css">
</head>
<body>
{% include "icones.njk" %}
{{ content | safe }}
{% if js %}<script src="/assets/js/{{ js }}.js" defer></script>
{% endif %}</body>
</html>
